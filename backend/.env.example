# Email / Inbox — company mailbox hosts (shared) + per-user credentials on Users page.
#
# 1) cPanel / standard SMTP+IMAP mail (e.g. mail.kafi-group.com) — recommended.
#    Get IMAP/SMTP host+ports from cPanel "Mail Client Manual Settings"
#    (webmail login e.g. https://your-domain.com:2096/).
#    Each app user gets their own mailbox email/password (Users page) — not one shared inbox.
#
# MAILBOX_ENABLED=true
# MAILBOX_IMAP_HOST=67.23.252.42        # use direct IP if Cloudflare proxies the hostname
# MAILBOX_IMAP_PORT=993             # IMAP SSL
# MAILBOX_SMTP_HOST=67.23.252.42
# MAILBOX_SMTP_PORT=465             # SMTP SSL (implicit TLS)
# MAILBOX_SSL_HOSTNAME=mail.kafi-group.com  # cert hostname when hosts are a raw IP
# MAILBOX_CREDENTIALS_KEY=          # Fernet key for encrypting per-user mailbox passwords
# Per-user mailboxes (synced onto app_users at startup):
# MAILBOX_ADMIN_EMAIL=admin@kafi-group.com
# MAILBOX_ADMIN_PASSWORD=
# MAILBOX_ADMIN_DISPLAY_NAME=
# MAILBOX_ASIM_EMAIL=marketing@kafi-group.com
# MAILBOX_ASIM_PASSWORD=
# MAILBOX_ASIM_DISPLAY_NAME=Anjum Ali
# MAILBOX_USMAN_EMAIL=info@kafi-group.com
# MAILBOX_USMAN_PASSWORD=
# MAILBOX_USMAN_DISPLAY_NAME=Asad Ali
# MAILBOX_SADIA_EMAIL=essence@kafi-group.com
# MAILBOX_SADIA_PASSWORD=
# MAILBOX_SADIA_DISPLAY_NAME=
# # Optional legacy single-mailbox fallback (prefer per-user above):
# # MAILBOX_EMAIL=test@kafi-group.com
# # MAILBOX_PASSWORD=
# # MAILBOX_DISPLAY_NAME=Kafi Commodities
#
# 2) Outlook.com via OAuth (IMAP receive + Microsoft Graph Mail.Send) — used only when
#    MAILBOX_CLIENT_ID + MAILBOX_REFRESH_TOKEN are set below (personal @outlook.com often
#    has SMTP AUTH disabled — 5.7.139 — so this mode bypasses SMTP entirely via Graph).
#    Setup: python scripts/get_outlook_refresh_token.py
#    Azure: Microsoft Graph → Delegated → Mail.Send (+ IMAP consent via the script)
#
# MAILBOX_CLIENT_ID=
# MAILBOX_CLIENT_SECRET=          # optional for public/desktop apps
# MAILBOX_REFRESH_TOKEN=
# MAILBOX_TENANT_ID=consumers       # use your Azure tenant id for work/school accounts
#
# INBOX_SINCE=2026-07-08            # optional — only show mail from this date/time onward
#
# Email open tracking (Insights) — public API URL used in tracking pixels.
# Required for opens to register. When unset, TWILIO_WEBHOOK_BASE_URL is used.
# Must be the live Railway host — no trailing /api (wrong host = 0 opens forever).
# PUBLIC_API_BASE_URL=https://kafi-sales-agent.up.railway.app
# EMAIL_TRACK_SECRET=               # optional; defaults to mailbox password (keep stable)
#
# Outbound on Railway Hobby (SMTP ports 25/465/587 are blocked):
# Use Resend HTTPS instead of SMTP. Keep MAILBOX_* for IMAP inbox + Sent copies.
#
# 1) Create account at https://resend.com → API Keys → create key
# 2) Domains → Add kafi-group.com → add the DNS records Resend shows (SPF/DKIM)
# 3) Wait until domain status is Verified
# 4) Set on Railway (and local .env for testing):
# RESEND_API_KEY=re_xxxxxxxx
# Emails send as each user's mailbox address (MAILBOX_ADMIN_EMAIL, etc.).
#
# Vercel mailer (recommended on Railway Hobby — SMTP on Vercel, not Railway):
# Deploy /mailer as its own Vercel project, then set on Railway:
# MAILER_HANDOFF_SECRET=<long random shared secret>
# MAILER_PUBLIC_URL=https://your-mailer.vercel.app
# Frontend: VITE_BULK_MAILER_URL=https://your-mailer.vercel.app
#
# Lead discovery / Research & Score enrichment (see modules/web_search.py + company_enrichment.py)
# Default combined providers: serpapi,duckduckgo,google_cse,wikidata
# CompanyLens runs after a website/domain is found (fills socials + contacts).
#
WEB_SEARCH_COMBINED_PROVIDERS=serpapi,brave,duckduckgo,wikidata
WEB_SEARCH_PROVIDERS=serpapi,brave,duckduckgo,wikidata
# SERPAPI_API_KEY=                    # primary key
# SERPAPI_API_KEYS=key2,key3          # optional extras — auto-rotates on 429/quota
# BRAVE_API_KEY=                      # https://api.search.brave.com — free tier ~2k queries/mo
# GOOGLE_CSE_API_KEY=                 # optional — https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_ENGINE_ID=               # Programmable Search Engine cx id (pair with above)
# COMPANYLENS_API_KEY=                # https://companylens.dev/ — 500 free lookups/mo
# DuckDuckGo + Wikidata need no API keys (ddgs package + public Wikidata SPARQL).

# WhatsApp Cloud API (Meta) — Essence brand line ONLY (integrations/whatsapp_client.py)
# Do NOT mix WABAs. This app must use ONE Phone Number ID that matches the
# Meta Verified number customers see (Essence). Wrong Phone Number ID = inbox
# shows "sent" while phones never receive.
#
# Essence (verify IDs in Meta → WhatsApp → API Setup before pasting):
#   WABA name:                 Essence
#   WHATSAPP_BUSINESS_ACCOUNT_ID = <from Meta API Setup>
#   WHATSAPP_PHONE_NUMBER_ID     = <from Meta API Setup for the Essence number>
#   WHATSAPP_DISPLAY_NUMBER      = E.164 of that same number (e.g. +92307…)
#
# Setup:
# 1. Meta Business Manager → WABA "Essence" → confirm the live phone number.
# 2. developers.facebook.com → app → WhatsApp → API Setup → copy Phone Number ID + WABA ID.
# 3. System User permanent token (whatsapp_business_messaging + whatsapp_business_management)
#    → WHATSAPP_ACCESS_TOKEN. Token must be for the SAME WABA as the Phone Number ID.
# 4. App → Settings → Basic → App secret → WHATSAPP_APP_SECRET.
# 5. WHATSAPP_WEBHOOK_VERIFY_TOKEN = your random string; Meta webhook Callback URL:
#      https://YOUR-PUBLIC-API/api/webhooks/whatsapp
#    Subscribe: messages, message_template_status_update.
# 6. Create/sync templates in dashboard (WhatsApp templates).
#
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-string
# WHATSAPP_DISPLAY_NUMBER=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VALIDATE_WEBHOOKS=true
# BULK_WHATSAPP_MESSAGE_DELAY_SECONDS=2.0
# BULK_WHATSAPP_MAX_PER_REQUEST=250
#
# Smoke test (admin JWT): POST /api/whatsapp/test-send
#   {"phone":"+92XXXXXXXXXX","template_name":"hello_world","template_language":"en_US"}
# Free-form text only works after the recipient messages you (24h window).
# If UI says sent but phone is silent: check bubble wa_status (failed/delivered),
# Railway env Phone Number ID vs Meta API Setup, and webhook delivery statuses.

# Twilio Voice — browser calling from dashboard (integrations/voice_client.py)
# Flow: click Call in dashboard → talk via browser mic → client is dialed directly.
#
# Setup:
# 1. Twilio Console → Account SID + Primary Auth Token
# 2. Buy a Voice-capable phone number → TWILIO_PHONE_NUMBER
# 3. Console → Account → API keys & tokens → Create API Key
#    → TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET
# 4. Console → Voice → TwiML → TwiML Apps → Create new App
#    Voice Request URL (POST):
#    https://YOUR-PUBLIC-API/api/webhooks/twilio/voice/client-dial
#    → copy App SID to TWILIO_TWIML_APP_SID
# 5. Console → Voice → Settings → Geo permissions — enable every country you dial
#    (blocked countries → "application error" / 31005, never rings or voicemail)
# 6. Local dev: ngrok http 8001 → TWILIO_WEBHOOK_BASE_URL=https://abc.ngrok-free.app
# 7. Restart backend
#    TWILIO_WEBHOOK_BASE_URL must be the same public HTTPS origin as the TwiML App URL
#    (Railway API URL, no trailing slash).
#
# Calls are recorded automatically (Twilio Dial recording). After the call ends,
# the recording is saved and closed captions (speech-to-text) are generated with
# Gemini when GEMINI_API_KEY is set.
#
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=your_primary_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_API_KEY_SID=SKxxxxxxxx
# TWILIO_API_KEY_SECRET=your_api_key_secret
# TWILIO_TWIML_APP_SID=APxxxxxxxx
# TWILIO_WEBHOOK_BASE_URL=https://abc123.ngrok-free.app
# TWILIO_VALIDATE_WEBHOOKS=true

# Meta Graph API (configure when ready)
# META_ACCESS_TOKEN=
# META_PAGE_ID=

# DB connection pool (Railway/Supabase).
# Default 8+17 handles concurrent CRM polls + background jobs on a single worker.
# Each uvicorn worker opens its own pool, so total conns = workers × (pool_size + max_overflow).
# Prefer Supabase session pooler (port 6543) in DATABASE_URL.
# DB_POOL_SIZE=8
# DB_MAX_OVERFLOW=17
# DB_POOL_TIMEOUT=20

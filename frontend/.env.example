# Local: leave API base relative so Vite proxies /api → backend (same-origin cookies).
VITE_BACKEND_URL=http://127.0.0.1:8001
# Prefer unset or /api (same-origin). Do NOT point at absolute Railway URL on Vercel —
# vercel.json rewrites /api → Railway so httpOnly cookies stay on your Vercel domain.
# On Vercel set ONLY: VITE_API_BASE_URL=/api
# Wrong (breaks login): kafi-sales-agent.up.railway.app  or  https://...railway.app without /api
# VITE_API_BASE_URL=/api

# Optional external quotation agent
# VITE_QUOTATION_AGENT_URL=https://kafiai-agents.vercel.app/cnf

# Vercel mailer URL is no longer required on the frontend — "Send emails" calls
# POST /api/mailer/handoff and opens the URL returned by Railway (MAILER_PUBLIC_URL).
# Optional: VITE_BULK_MAILER_URL=https://mailer-pied.vercel.app
